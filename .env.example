# Stock Service configuration

# Dedicated PostgreSQL (stock-db container in docker-compose.yml)
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=stock_db

# Shared HS256 secret — MUST be identical to auth-service JWT_SECRET
JWT_SECRET=YOUR_SECRET_KEY_HERE

# Connection string when running outside docker (compose overrides it):
ConnectionStrings__StockDb=Host=localhost;Port=5434;Database=stock_db;Username=stock_user;Password=YOUR_PASSWORD
