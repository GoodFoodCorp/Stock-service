# Stock Service configuration

# Dedicated PostgreSQL (stock-db container in docker-compose.yml)
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=stock_db

# Shared HS256 secret — MUST be identical to auth-service JWT_SECRET
JWT_SECRET=YOUR_SECRET_KEY_HERE

# Shared secret for internal calls from order-service (X-Service-Key header) — MUST be
# identical to SERVICE_API_KEY of order-service and menu-service
SERVICE_API_KEY=YOUR_SERVICE_API_KEY

# menu-service base URL, to check which recipes use a stock item before a delete/rename
# (compose overrides it; default http://menu-service:8085)
# MENU_SERVICE_URL=http://localhost:8085

# Connection string when running outside docker (compose overrides it):
ConnectionStrings__StockDb=Host=localhost;Port=5434;Database=stock_db;Username=stock_user;Password=YOUR_PASSWORD
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api
